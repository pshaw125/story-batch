{
  "name": "story-batch",
  "version": "0.1.0",
  "private": true,
  "description": "Offline image batch desktop application",
  "main": "dist/src/desktop/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ui.cjs",
    "test": "npm run build && node scripts/test.cjs",
    "start": "npm run build && node scripts/launch.cjs",
    "host:probe": "npm run build && node scripts/launch.cjs --host-probe",
    "package": "npm run build && node scripts/package.cjs",
    "setup:electron": "node node_modules/electron/install.js",
    "render": "npm run build && node dist/src/node/render-cli.js"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.2",
    "electron": "45.3.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "ws": "8.22.2"
  },
  "overrides": {
    "glob": "14.0.5",
    "minimatch": "11.0.8"
  }
}
